{
  "name": "giftstore-api",
  "version": "1.0.0",
  "description": "Backend API for Gift Store (Express + Prisma + PostgreSQL)",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate --schema=prisma/schema.prisma && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=prisma/schema.prisma",
    "db:seed": "prisma db seed",
    "seed": "tsx prisma/seed.ts",
    "seed:popular": "tsx scripts/seedPopular.ts",
    "seed:samples": "tsx scripts/seedSampleProducts.ts",
    "slugs": "tsx scripts/printSlugs.ts",
    "sitemaps": "tsx scripts/generate-sitemaps.ts",
    "blog:import": "tsx scripts/import-blog.ts",
    "blog:import:dry": "tsx scripts/import-blog.ts --dry",
    "blog:import:clear": "tsx scripts/import-blog.ts --clear",
    "blog:import:only": "tsx scripts/import-blog.ts --only prezenty-dla-niej-2025",
    "blog:import:draft": "tsx scripts/import-blog.ts --draft"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "dotenv-expand": "^12.0.3",
    "express": "^4.19.2",
    "express-rate-limit": "^8.0.1",
    "fastify": "^5.5.0",
    "framer-motion": "^12.23.18",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.526.0",
    "multer": "^2.0.2",
    "nanoid": "^5.1.5",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.5",
    "passport": "^0.7.0",
    "passport-apple": "^2.0.2",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.17.2",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "stripe": "^18.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/pdfkit": "^0.17.3",
    "pino-pretty": "^13.1.1",
    "prisma": "^6.16.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "keywords": [
    "express",
    "prisma",
    "postgresql",
    "backend",
    "api",
    "giftstore"
  ],
  "author": "Gift Store Team",
  "license": "MIT"
}
