#!/usr/bin/env sh

set -e

echo "[pre-commit] Running Gitleaks on staged files..."

# ✅ Najpierw sprawdź, czy Gitleaks jest dostępny w PATH
if command -v gitleaks >/dev/null 2>&1; then
  GL="gitleaks"
# 🔄 Jeśli nie — spróbuj znaleźć go w typowej lokalizacji Winget
elif [ -n "$LOCALAPPDATA" ] && [ -f "$LOCALAPPDATA/Microsoft/WinGet/Packages/Gitleaks.Gitleaks_Microsoft.Winget.Source_8wekyb3d8bbwe/gitleaks.exe" ]; then
  GL="$LOCALAPPDATA/Microsoft/WinGet/Packages/Gitleaks.Gitleaks_Microsoft.Winget.Source_8wekyb3d8bbwe/gitleaks.exe"
else
  echo "⚠️  Gitleaks not found (PATH). Skipping secret scan."
  exit 0
fi

# 🚀 Uruchom skan Gitleaks na staged files
"$GL" protect --staged --redact --no-banner
status=$?

if [ $status -ne 0 ]; then
  echo "❌ Gitleaks found potential secrets. Commit blocked."
  exit $status
fi

echo "✅ No secrets detected by Gitleaks."
