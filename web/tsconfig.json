{
  "compilerOptions": {
    /* Podstawy platformy/przeglądarki */
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],

    /* Moduły + JSX (Vite/React) */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    /* Praca z plikami .js/.jsx obok .ts/.tsx */
    "allowJs": true,
    "checkJs": false,

    /* Jakość i ergonomia */
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Zgodność importów */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    /* Typy środowiska (Vite + ewentualnie Node w toolingu) */
    "types": ["vite/client", "node"],

    /* Aliasowanie ścieżek – patrz też baseUrl */
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"],
      "@data/*": ["data/*"],
      "@components/*": ["components/*"]
    }
  },
  "include": [
    "src",
    "vite-env.d.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
